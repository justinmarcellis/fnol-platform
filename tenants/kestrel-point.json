  "fastTrack": {
    "enabled": true,
    "maxSeverity": 15,
    "maxFraudScore": 10,
    "maxEstimate": {
      "amount": 900,
      "currency": "USD"
    },
    "queue": "fast_track"
  },
  "severityBands": {
    "moderate": 20,
    "major": 45,
    "severe": 70
  },
  "timers": [
    {
      "id": "MI-ACK",
      "state": "MI",
      "kind": "acknowledge",
      "duration": {
        "value": 10,
        "unit": "days"
      },
      "startOn": "claim.reported",
      "lobs": [
        "personal_auto",
        "commercial_auto"
      ],
      "stopOn": {
        "taskType": "acknowledge_claimant"
      },
      "warnBefore": {
        "value": 3,
        "unit": "days"
      },
      "onBreach": [
        {
          "type": "add_flag",
          "flag": "ack_breach"
        },
        {
          "type": "notify",
          "template": "timer_breach_internal"
        },
        {
          "type": "add_task",
          "task": {
            "type": "timer_breach_followup",
            "title": "Resolve breached deadline (ack_breach)",
            "dueInHours": 8,
            "queue": "personal_auto_claims"
          }
        }
      ],
      "citation": "MI acknowledgement deadline (demo value 10 days). Illustrative, not legal advice."
    },
    {
      "id": "MI-CONTACT",
      "state": "MI",
      "kind": "contact",
      "duration": {
        "value": 2,
        "unit": "business_days"
      },
      "startOn": "claim.reported",
      "lobs": [
        "personal_auto"
      ],
      "stopOn": {
        "taskType": "first_contact"
      },
      "warnBefore": {
        "value": 1,
        "unit": "business_days"
      },
      "onBreach": [
        {
          "type": "add_flag",
          "flag": "contact_breach"
        },
        {
          "type": "notify",
          "template": "timer_breach_internal"
        },
        {
          "type": "add_task",
          "task": {
            "type": "timer_breach_followup",
            "title": "Resolve breached deadline (contact_breach)",
            "dueInHours": 4,
            "queue": "personal_auto_claims"
          }
        }
      ],
      "citation": "MI first contact target (demo value 2 business days). Illustrative, not legal advice."
    },
    {
      "id": "MI-DECIDE-PA",
      "state": "MI",
      "kind": "decide",
      "duration": {
        "value": 30,
        "unit": "days"
      },
      "startOn": "claim.reported",
      "lobs": [
        "personal_auto"
      ],
      "stopOn": {
        "toStatus": [
          "closed",
          "withdrawn"
        ]
      },
      "warnBefore": {
        "value": 5,
        "unit": "days"
      },
      "onBreach": [
        {
          "type": "add_flag",
          "flag": "decision_breach"
        },
        {
          "type": "notify",
          "template": "timer_breach_internal"
        },
        {
          "type": "add_task",
          "task": {
            "type": "timer_breach_followup",
            "title": "Resolve breached deadline (decision_breach)",
            "dueInHours": 24,
            "queue": "personal_auto_claims"
          }
        }
      ],
      "citation": "MI personal auto decision deadline (demo value 30 days). Illustrative, not legal advice."
    },
    {
      "id": "MI-DECIDE-CA",
      "state": "MI",
      "kind": "decide",
      "duration": {
        "value": 60,
        "unit": "days"
      },
      "startOn": "claim.reported",
