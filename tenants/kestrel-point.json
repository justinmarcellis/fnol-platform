          "causes": [
            "theft",
            "vandalism"
          ]
        }
      ]
    },
    {
      "id": "commercial_auto",
      "enabled": true,
      "label": "Commercial auto",
      "acordLobCd": "AUTOB",
      "states": [
        "MI"
      ],
      "channels": [
        "csr_phone",
        "api"
      ],
      "lossTypes": [
        {
          "id": "collision",
          "label": "Collision",
          "causes": [
            "collision",
            "single_vehicle",
            "hit_and_run"
          ]
        },
        {
          "id": "cargo_loss",
          "label": "Cargo loss",
          "causes": [
            "theft",
            "other"
          ]
        },
        {
          "id": "liability",
          "label": "Third-party liability",
          "causes": [
            "liability_bodily_injury",
            "liability_property_damage"
          ]
        }
      ]
    }
  ],
  "questionSets": [
    {
      "id": "auto-general",
      "lob": "personal_auto",
      "version": 1,
      "questions": [
        {
          "id": "loss_date",
          "text": "Date of loss",
          "type": "date",
          "required": true,
          "validation": {
            "notInFuture": true
          },
          "mapsTo": "loss.lossDate",
          "order": 10,
          "section": "loss"
        },
        {
          "id": "loss_time",
          "text": "Approximate time of loss",
          "type": "time",
          "order": 15,
          "section": "loss"
        },
        {
          "id": "loss_description",
          "text": "Describe what happened",
          "type": "longtext",
          "required": true,
          "aiAssist": false,
          "mapsTo": "loss.description",
          "order": 20,
          "section": "loss"
        },
        {
          "id": "injuries",
          "text": "Were any injuries reported?",
          "type": "boolean",
          "required": true,
          "mapsTo": "loss.injuriesReported",
          "order": 30,
          "section": "loss"
        },
        {
          "id": "police_report_number",
          "text": "Police report number",
          "type": "text",
          "requiredIf": {
            "fact": "answers.injuries",
            "op": "eq",
            "value": true
          },
          "validation": {
            "maxLength": 40
          },
          "order": 35,
          "section": "loss"
        },
        {
          "id": "vehicle_drivable",
          "text": "Is the vehicle drivable?",
          "type": "boolean",
          "required": true,
          "order": 40,
          "section": "vehicle"
        },
        {
          "id": "prior_damage",
          "text": "Was there prior unrepaired damage?",
          "type": "boolean",
          "order": 45,
          "section": "vehicle"
        },
        {
          "id": "witnesses",
          "text": "Were there witnesses?",
          "type": "boolean",
          "order": 50,
          "section": "parties"
        },
        {
          "id": "witness_info",
          "text": "Witness details",
          "type": "party",
          "showIf": {
            "fact": "answers.witnesses",
            "op": "eq",
            "value": true
          },
          "pii": true,
          "order": 55,
          "section": "parties"
        },
        {
          "id": "fraud_disclosure",
          "text": "I understand that knowingly giving false information is a crime.",
          "type": "disclosure",
          "required": true,
          "order": 99,
          "section": "submit"
        }
      ]
    },
    {
      "id": "auto-glass",
      "lob": "personal_auto",
      "lossTypes": [
        "glass"
      ],
      "version": 1,
      "questions": [
        {
          "id": "loss_date",
          "text": "Date glass was damaged",
          "type": "date",
          "required": true,
          "validation": {
            "notInFuture": true
          },
          "mapsTo": "loss.lossDate",
          "order": 10,
          "section": "loss"
        },
        {
          "id": "injuries",
          "text": "Were any injuries reported?",
          "type": "boolean",
          "required": true,
          "mapsTo": "loss.injuriesReported",
          "order": 20,
          "section": "loss"
        },
        {
          "id": "vehicle_drivable",
          "text": "Is the vehicle drivable?",
          "type": "boolean",
          "required": true,
          "order": 30,
          "section": "vehicle"
        },
        {
          "id": "prior_damage",
          "text": "Was there prior unrepaired glass damage?",
          "type": "boolean",
          "required": true,
          "order": 40,
          "section": "vehicle"
        },
        {
          "id": "fraud_disclosure",
          "text": "I understand that knowingly giving false information is a crime.",
          "type": "disclosure",
          "required": true,
          "order": 99,
          "section": "submit"
        }
      ]
    },
    {
      "id": "commauto-general",
      "lob": "commercial_auto",
      "version": 1,
      "questions": [
        {
          "id": "loss_date",
          "text": "Date of loss",
          "type": "date",
          "required": true,
          "validation": {
            "notInFuture": true
          },
          "mapsTo": "loss.lossDate",
          "order": 10,
          "section": "loss"
        },
        {
          "id": "loss_description",
          "text": "Describe what happened",
          "type": "longtext",
          "required": true,
          "mapsTo": "loss.description",
          "order": 20,
          "section": "loss"
        },
        {
          "id": "unit_number",
          "text": "Fleet unit number",
          "type": "text",
          "required": true,
          "validation": {
            "maxLength": 20
          },
          "order": 25,
          "section": "fleet"
        },
        {
          "id": "driver_is_employee",
          "text": "Was the driver an employee?",
          "type": "boolean",
          "required": true,
          "order": 30,
          "section": "fleet"
        },
        {
          "id": "driver_employee_ref",
          "text": "Driver employee reference",
          "type": "text",
          "showIf": {
            "fact": "answers.driver_is_employee",
            "op": "eq",
            "value": true
          },
          "pii": true,
          "order": 35,
          "section": "fleet"
        },
        {
          "id": "injuries",
          "text": "Were any injuries reported?",
          "type": "boolean",
          "required": true,
          "mapsTo": "loss.injuriesReported",
          "order": 40,
          "section": "loss"
        },
        {
          "id": "dot_recordable",
          "text": "Is the event DOT-recordable?",
          "type": "boolean",
          "required": true,
          "order": 45,
          "section": "compliance"
        },
        {
          "id": "cargo_involved",
          "text": "Was cargo involved?",
          "type": "boolean",
          "required": true,
          "order": 50,
          "section": "cargo"
        },
        {
          "id": "hazmat_involved",
          "text": "Was hazardous material involved?",
          "type": "boolean",
          "showIf": {
            "fact": "answers.cargo_involved",
            "op": "eq",
            "value": true
          },
          "requiredIf": {
            "fact": "answers.cargo_involved",
            "op": "eq",
            "value": true
          },
          "order": 55,
          "section": "cargo"
        },
        {
          "id": "cargo_description",
          "text": "Describe the cargo",
          "type": "text",
          "showIf": {
            "fact": "answers.cargo_involved",
            "op": "eq",
            "value": true
          },
          "order": 60,
          "section": "cargo"
        },
        {
          "id": "vehicle_drivable",
          "text": "Is the unit drivable?",
          "type": "boolean",
          "required": true,
          "order": 65,
          "section": "vehicle"
        },
        {
          "id": "fraud_disclosure",
          "text": "I understand that knowingly giving false information is a crime.",
          "type": "disclosure",
          "required": true,
          "order": 99,
          "section": "submit"
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "IN-HAZMAT-GUARD",
      "name": "Hazmat cargo requires description",
      "stage": "intake",
      "priority": 10,
      "appliesTo": {
        "lobs": [
          "commercial_auto"
        ]
      },
      "when": {
        "fact": "answers.hazmat_involved",
        "op": "eq",
        "value": true
      },
      "then": [
        {
          "type": "require_question",
          "questionId": "cargo_description"
        }
      ]
    },
    {
      "id": "TR-INJURY-SEV",
      "name": "Injury raises severity",
      "stage": "triage",
      "priority": 10,
      "when": {
        "fact": "loss.injuriesReported",
        "op": "eq",
        "value": true
      },
      "then": [
        {
          "type": "add_severity",
          "points": 40
        },
        {
          "type": "set_complexity",
          "complexity": "high"
        }
      ]
    },
    {
      "id": "TR-PRIOR-DAMAGE",
      "name": "Prior damage adds fraud-review severity",
      "stage": "triage",
      "priority": 20,
      "appliesTo": {
        "lobs": [
          "personal_auto"
        ]
      },
      "when": {
        "fact": "answers.prior_damage",
        "op": "eq",
        "value": true
      },
      "then": [
        {
          "type": "add_severity",
          "points": 10
        },
        {
          "type": "add_flag",
          "flag": "prior_damage"
        }
      ]
    },
    {
      "id": "TR-CA-HAZMAT",
      "name": "Hazmat is complex",
      "stage": "triage",
      "priority": 30,
      "appliesTo": {
        "lobs": [
          "commercial_auto"
        ]
      },
      "when": {
        "fact": "answers.hazmat_involved",
        "op": "eq",
        "value": true
      },
      "then": [
        {
          "type": "set_complexity",
          "complexity": "high"
        },
        {
          "type": "add_severity",
          "points": 25
        }
      ]
    },
    {
      "id": "RT-INJURY-01",
      "name": "Injury to injury queue",
      "stage": "routing",
      "priority": 10,
      "when": {
        "any": [
          {
            "fact": "loss.injuriesReported",
            "op": "eq",
            "value": true
          },
          {
            "fact": "loss.fatality",
            "op": "eq",
            "value": true
          }
        ]
      },
      "then": [
        {
          "type": "route_queue",
          "queue": "injury"
        },
        {
          "type": "deny_fast_track",
          "reason": "injury"
        },
        {
          "type": "add_flag",
          "flag": "injury"
        }
      ]
    },
    {
      "id": "RT-SIU-01",
      "name": "Fraud score to SIU (strict threshold 40)",
      "stage": "routing",
      "priority": 20,
      "when": {
        "fact": "triage.fraud.score",
        "op": "gte",
        "value": 40
      },
      "then": [
        {
          "type": "refer_siu",
          "reason": "fraud score at or above 40"
        },
        {
          "type": "route_queue",
          "queue": "siu"
        },
        {
          "type": "deny_fast_track",
          "reason": "fraud"
        }
      ]
    },
    {
      "id": "RT-NO-STP-THEFT",
      "name": "Theft never fast tracked",
      "stage": "routing",
      "priority": 25,
      "when": {
        "fact": "loss.cause",
        "op": "in",
        "value": [
          "theft",
          "vandalism"
        ]
      },
      "then": [
        {
          "type": "deny_fast_track",
          "reason": "theft needs review"
        },
        {
          "type": "add_flag",
          "flag": "theft_review"
        }
      ]
    },
    {
      "id": "RT-PA-DEFAULT",
      "name": "Personal auto default queue",
      "stage": "routing",
      "priority": 90,
      "appliesTo": {
        "lobs": [
          "personal_auto"
        ]
      },
      "when": true,
      "then": [
        {
          "type": "route_queue",
          "queue": "personal_auto_claims"
        }
      ]
    },
    {
      "id": "RT-CA-DEFAULT",
      "name": "Commercial auto default queue",
      "stage": "routing",
      "priority": 90,
      "appliesTo": {
        "lobs": [
          "commercial_auto"
        ]
      },
      "when": true,
      "then": [
        {
          "type": "route_queue",
          "queue": "commercial_auto_claims"
        },
        {
          "type": "deny_fast_track",
          "reason": "commercial lines are not fast tracked"
        }
      ]
    },
    {
      "id": "RT-CA-HAZMAT",
      "name": "Hazmat to specialty queue",
      "stage": "routing",
      "priority": 30,
      "appliesTo": {
        "lobs": [
          "commercial_auto"
        ]
      },
      "when": {
        "fact": "answers.hazmat_involved",
        "op": "eq",
        "value": true
      },
      "then": [
        {
          "type": "route_queue",
          "queue": "commercial_specialty"
        },
        {
          "type": "add_flag",
          "flag": "hazmat"
        },
        {
          "type": "add_task",
          "task": {
            "type": "hazmat_notice_review",
            "title": "Review hazmat notification duties",
            "dueInHours": 4,
            "queue": "commercial_specialty"
          }
        }
      ]
    },
    {
      "id": "RT-CA-DOT",
      "name": "DOT-recordable events flagged",
      "stage": "routing",
      "priority": 35,
      "appliesTo": {
        "lobs": [
          "commercial_auto"
        ]
      },
      "when": {
        "fact": "answers.dot_recordable",
        "op": "eq",
        "value": true
      },
      "then": [
        {
          "type": "add_flag",
          "flag": "dot_recordable"
        },
        {
          "type": "notify",
          "template": "dot_recordable_internal"
        }
      ]
    },
    {
      "id": "RT-FT-GLASS",
      "name": "Straight-through: glass only",
      "stage": "routing",
      "priority": 50,
      "appliesTo": {
        "lobs": [
          "personal_auto"
        ]
      },
      "when": {
        "all": [
          {
            "fact": "loss.cause",
            "op": "eq",
            "value": "glass"
          },
          {
            "fact": "triage.severityScore",
            "op": "lt",
            "value": 15
          },
          {
            "fact": "coverage.outcome",
            "op": "eq",
            "value": "covered"
          },
          {
            "fact": "answers.prior_damage",
            "op": "eq",
            "value": false
          }
        ]
      },
      "then": [
        {
          "type": "fast_track"
        },
        {
          "type": "route_queue",
          "queue": "fast_track"
        }
      ]
    },
    {
      "id": "PR-SUBRO-PA",
      "name": "Subrogation check on collisions",
      "stage": "post_routing",
      "priority": 10,
      "appliesTo": {
        "lobs": [
          "personal_auto"
        ],
        "lossTypes": [
          "collision"
        ]
      },
      "when": {
        "fact": "loss.cause",
        "op": "in",
        "value": [
          "collision",
          "hit_and_run"
        ]
      },
      "then": [
        {
          "type": "add_task",
          "task": {
            "type": "subrogation_review",
            "title": "Check third-party recovery",
            "dueInHours": 96,
            "queue": "personal_auto_claims"
          }
        }
      ]
    }
  ],
  "queues": [
