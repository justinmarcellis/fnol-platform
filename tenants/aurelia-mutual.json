            "en": "Was a police report filed?",
            "es": "¿Se presentó un informe policial?"
          },
          "type": "boolean",
          "order": 70,
          "section": "loss"
        },
        {
          "id": "photos",
          "text": {
            "en": "Add photos of the damage.",
            "es": "Agregue fotos de los daños."
          },
          "type": "media",
          "aiAssist": true,
          "order": 80,
          "section": "evidence"
        },
        {
          "id": "fraud_disclosure",
          "text": {
            "en": "I understand that knowingly giving false information is a crime.",
            "es": "Entiendo que dar información falsa a sabiendas es un delito."
          },
          "type": "disclosure",
          "required": true,
          "order": 99,
          "section": "submit"
        }
      ]
    },
