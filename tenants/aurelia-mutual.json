  "rules": [
    {
      "id": "IN-OTHER-PARTY",
      "name": "Collect other party when involved",
      "stage": "intake",
      "priority": 10,
      "when": {
        "fact": "answers.other_party_involved",
        "op": "eq",
        "value": true
      },
      "then": [
        {
          "type": "require_question",
          "questionId": "other_party_info"
        }
      ],
      "appliesTo": {
        "lobs": [
          "personal_auto"
        ]
      }
    },
    {
      "id": "TR-INJURY-SEV",
      "name": "Injury raises complexity (triage already scores injury severity)",
      "stage": "triage",
      "priority": 10,
      "when": {
        "fact": "loss.injuriesReported",
        "op": "eq",
        "value": true
      },
      "then": [
        {
          "type": "set_complexity",
          "complexity": "high"
        }
      ]
    },
    {
      "id": "TR-HOME-UNLIVABLE",
      "name": "Uninhabitable home raises complexity (triage already scores habitability)",
      "stage": "triage",
      "priority": 20,
      "appliesTo": {
        "lobs": [
          "homeowners"
        ]
      },
      "when": {
        "fact": "answers.home_livable",
        "op": "eq",
        "value": false
      },
      "then": [
        {
          "type": "set_complexity",
          "complexity": "high"
        }
      ]
    },
    {
      "id": "RT-INJURY-01",
      "name": "Injury to injury queue",
      "stage": "routing",
      "priority": 10,
      "when": {
        "any": [
          {
            "fact": "loss.injuriesReported",
            "op": "eq",
            "value": true
          },
          {
            "fact": "loss.fatality",
            "op": "eq",
            "value": true
          }
        ]
      },
      "then": [
        {
          "type": "route_queue",
          "queue": "injury"
        },
        {
          "type": "deny_fast_track",
          "reason": "injury"
        },
        {
          "type": "add_flag",
          "flag": "injury"
        }
      ]
    },
    {
      "id": "RT-SIU-01",
      "name": "High fraud score to SIU (threshold 60)",
      "stage": "routing",
      "priority": 20,
      "when": {
        "fact": "triage.fraud.score",
        "op": "gte",
        "value": 60
      },
      "then": [
        {
          "type": "refer_siu",
          "reason": "fraud score at or above 60"
        },
        {
          "type": "route_queue",
          "queue": "siu"
        },
        {
          "type": "deny_fast_track",
          "reason": "fraud"
        }
      ]
    },
    {
      "id": "RT-AUTO-DEFAULT",
      "name": "Auto default queue",
      "stage": "routing",
      "priority": 90,
      "appliesTo": {
        "lobs": [
          "personal_auto"
        ]
      },
      "when": true,
      "then": [
        {
          "type": "route_queue",
          "queue": "auto_physical_damage"
        }
      ]
    },
    {
      "id": "RT-HOME-DEFAULT",
      "name": "Home default queue",
      "stage": "routing",
      "priority": 90,
      "appliesTo": {
        "lobs": [
          "homeowners"
        ]
      },
      "when": true,
      "then": [
        {
          "type": "route_queue",
          "queue": "property"
        }
      ]
    },
    {
      "id": "RT-FT-GLASS",
      "name": "Straight-through: glass",
      "stage": "routing",
      "priority": 50,
      "appliesTo": {
        "lobs": [
          "personal_auto"
        ]
      },
      "when": {
        "all": [
          {
            "fact": "loss.cause",
            "op": "eq",
            "value": "glass"
          },
          {
            "fact": "triage.severityScore",
            "op": "lt",
            "value": 30
          },
          {
            "fact": "coverage.outcome",
            "op": "eq",
            "value": "covered"
          }
        ]
      },
      "then": [
        {
          "type": "fast_track"
        },
        {
          "type": "route_queue",
          "queue": "fast_track"
        }
      ]
    },
    {
      "id": "RT-FT-HOME-SMALL",
      "name": "Straight-through: home water damage under 2500",
      "stage": "routing",
      "priority": 50,
      "appliesTo": {
        "lobs": [
          "homeowners"
        ]
      },
      "when": {
        "all": [
          {
            "fact": "loss.cause",
            "op": "in",
            "value": [
              "water_plumbing",
              "water_weather",
              "freeze"
            ]
          },
          {
            "any": [
              {
                "fact": "answers.estimated_damage",
                "op": "lt",
                "value": 2500
              },
              {
                "fact": "triage.suggestedReserve.amount",
                "op": "lt",
                "value": 2500
              }
            ]
          },
          {
            "not": {
              "fact": "answers.home_livable",
              "op": "eq",
              "value": false
            }
          },
          {
            "fact": "coverage.outcome",
            "op": "eq",
            "value": "covered"
          },
          {
            "fact": "triage.severityScore",
            "op": "lt",
            "value": 30
          }
        ]
      },
      "then": [
        {
          "type": "fast_track"
        },
        {
          "type": "route_queue",
          "queue": "fast_track"
        }
      ]
    },
    {
      "id": "RT-HOME-CAT",
      "name": "Wind and hail flagged for catastrophe review",
      "stage": "routing",
      "priority": 40,
      "appliesTo": {
        "lobs": [
          "homeowners"
        ]
      },
      "when": {
        "fact": "loss.cause",
        "op": "in",
        "value": [
          "wind",
          "hail"
        ]
      },
      "then": [
        {
          "type": "add_flag",
          "flag": "catastrophe_review"
        }
      ]
    },
    {
      "id": "PR-SUBRO-AUTO",
      "name": "Other party involved: subrogation review task",
      "stage": "post_routing",
      "priority": 10,
      "appliesTo": {
        "lobs": [
          "personal_auto"
        ]
      },
      "when": {
        "fact": "answers.other_party_involved",
        "op": "eq",
        "value": true
      },
      "then": [
        {
          "type": "add_flag",
          "flag": "subrogation_candidate"
        },
        {
          "type": "add_task",
          "task": {
            "type": "subrogation_review",
            "title": "Review subrogation potential",
            "dueInHours": 72,
            "queue": "auto_physical_damage"
          }
        }
      ]
    },
    {
      "id": "PR-IL-ACK-NOTE",
      "name": "Illinois claimant acknowledgement",
      "stage": "post_routing",
      "priority": 20,
      "appliesTo": {
        "states": [
          "IL"
        ]
      },
      "when": true,
      "then": [
        {
          "type": "notify",
          "template": "ack_il"
        }
      ]
    }
  ],
  "queues": [
    {
      "id": "fast_track",
      "label": {
        "en": "Fast track",
        "es": "Vía rápida"
      },
      "lobs": [
        "personal_auto",
        "homeowners"
      ],
      "skills": [
        "stp"
      ],
      "adjusters": [
        "adj-aur-101",
        "adj-aur-102"
      ],
      "assignment": "round_robin",
      "slaHours": 4,
      "maxSeverity": 30
    },
    {
      "id": "auto_physical_damage",
      "label": {
        "en": "Auto physical damage",
        "es": "Daños materiales de auto"
      },
      "lobs": [
        "personal_auto"
      ],
      "skills": [
        "auto",
        "appraisal"
      ],
      "adjusters": [
        "adj-aur-201",
        "adj-aur-202",
        "adj-aur-203"
      ],
      "assignment": "round_robin",
      "slaHours": 24,
      "maxSeverity": 60
    },
    {
