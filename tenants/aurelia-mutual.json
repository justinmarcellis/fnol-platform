  "questionSets": [
    {
      "id": "auto-general",
      "lob": "personal_auto",
      "version": 1,
      "questions": [
        {
          "id": "loss_date",
          "text": {
            "en": "When did the loss happen?",
            "es": "¿Cuándo ocurrió la pérdida?"
          },
          "type": "date",
          "required": true,
          "validation": {
            "notInFuture": true
          },
          "mapsTo": "loss.lossDate",
          "order": 10,
          "section": "loss"
        },
        {
          "id": "loss_description",
          "text": {
            "en": "Tell us what happened.",
            "es": "Cuéntenos qué sucedió."
          },
          "type": "longtext",
          "required": true,
          "aiAssist": true,
          "mapsTo": "loss.description",
          "order": 20,
          "section": "loss"
        },
        {
          "id": "injuries",
          "text": {
            "en": "Was anyone hurt?",
            "es": "¿Hubo personas lesionadas?"
          },
          "type": "boolean",
          "required": true,
          "mapsTo": "loss.injuriesReported",
          "order": 30,
          "section": "loss"
        },
        {
          "id": "insured_vehicle",
          "text": {
            "en": "Which vehicle on your policy was involved?",
            "es": "¿Qué vehículo de su póliza estuvo involucrado?"
          },
          "type": "vehicle",
          "required": false,
          "order": 35,
          "section": "vehicle"
        },
        {
          "id": "vehicle_drivable",
          "text": {
            "en": "Can the vehicle be driven?",
            "es": "¿Se puede conducir el vehículo?"
          },
          "type": "boolean",
          "required": true,
          "order": 40,
          "section": "vehicle"
        },
        {
          "id": "other_party_involved",
          "text": {
            "en": "Was another vehicle or person involved?",
            "es": "¿Hubo otro vehículo o persona involucrada?"
          },
          "type": "boolean",
          "required": true,
          "order": 50,
          "section": "parties"
        },
        {
          "id": "other_party_info",
          "text": {
            "en": "Other party details",
            "es": "Datos de la otra parte"
          },
          "type": "party",
          "showIf": {
            "fact": "answers.other_party_involved",
            "op": "eq",
            "value": true
          },
          "requiredIf": {
            "fact": "answers.other_party_involved",
            "op": "eq",
            "value": true
