{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_USE_VERTEX": "1",
    "CLOUD_ML_REGION": "us-east5",
    "ANTHROPIC_VERTEX_PROJECT_ID": "fintechco-prod-sec-01",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(*)",
      "Edit(*)",
      "Bash(pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(go vet*)"
    ],
    "deny": [
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(rm -rf*)",
      "Bash(git push*)",
      "WebFetch(*)",
      "WebSearch",
      "Read(./.env*)",
      "Read(./secrets/**)"
    ]
  }
}
