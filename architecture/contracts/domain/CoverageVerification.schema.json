{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fnol-platform.example/domain/CoverageVerification.schema.json",
  "title": "Coverage verification",
  "description": "Result of checking a claim against its policy snapshot. Indicative only; coverage decisions stay with the carrier (overview.md scope).",
  "type": "object",
  "required": [
    "id",
    "tenantId",
    "claimId",
    "outcome",
    "checks",
    "verifiedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "tenantId": {
      "$ref": "common.schema.json#/$defs/TenantId"
    },
    "claimId": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "policySnapshotId": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "policyNumber": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "covered",
        "partial",
        "not_covered",
        "policy_not_found",
        "needs_review"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "passed"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "policy_found",
              "in_force",
              "loss_in_period",
              "vehicle_on_policy",
              "location_on_policy",
              "driver_listed",
              "driver_not_excluded",
              "peril_covered",
              "coverage_present",
              "fleet_unit_on_policy",
              "hnoa_coverage",
              "cargo_endorsed"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "matchedCoverages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicableDeductible": {
      "$ref": "common.schema.json#/$defs/Money"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifiedAt": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_force",
        "lapsed",
        "excluded",
        "not_found",
        "needs_review"
      ],
      "description": "Finer verdict (added 1.1.0, see modules.md coverage). in_force -> covered, lapsed/excluded -> not_covered, not_found -> policy_not_found, needs_review -> needs_review."
    },
    "deductible": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/Money"
        },
        {
          "type": "null"
        }
      ],
      "description": "Same value as applicableDeductible, or null when none applies (added 1.1.0)."
    },
    "limits": {
      "type": "object",
      "description": "Limits of the applicable coverages by coverage code (added 1.1.0).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "$ref": "common.schema.json#/$defs/Money"
          },
          "limitPerPerson": {
            "$ref": "common.schema.json#/$defs/Money"
          },
          "limitPerOccurrence": {
            "$ref": "common.schema.json#/$defs/Money"
          }
        }
      }
    },
    "applicableCoverages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Coverage codes that apply to the loss; same list as matchedCoverages (added 1.1.0)."
    }
  }
}
