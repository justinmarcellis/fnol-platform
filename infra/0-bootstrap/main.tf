# Stage 0: run once by an organization admin with local state.
# Creates the top-level "fnol" folder, a seed project, the Terraform state
# bucket and the service account that every later stage impersonates.

terraform {
  required_version = ">= 1.6"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.10"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

provider "google" {
  region = var.region
}

resource "google_folder" "fnol" {
  display_name = "fnol"
  parent       = "organizations/${var.org_id}"
}

module "seed" {
  source          = "../modules/project"
  project_id      = "${var.prefix}-seed"
  name            = "FNOL seed"
  folder_id       = google_folder.fnol.name
  billing_account = var.billing_account
  labels          = { system = "fnol", stage = "bootstrap" }
  services = [
    "accesscontextmanager.googleapis.com",
    "artifactregistry.googleapis.com",
    "cloudbilling.googleapis.com",
    "cloudkms.googleapis.com",
    "cloudresourcemanager.googleapis.com",
    "compute.googleapis.com",
    "iam.googleapis.com",
    "iamcredentials.googleapis.com",
    "logging.googleapis.com",
    "orgpolicy.googleapis.com",
    "serviceusage.googleapis.com",
    "servicenetworking.googleapis.com",
    "storage.googleapis.com",
    "sts.googleapis.com",
    "firebase.googleapis.com",
  ]
}

resource "google_storage_bucket" "tfstate" {
  project                     = module.seed.project_id
  name                        = "${var.prefix}-tfstate"
  location                    = "US"
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
  force_destroy               = false

  versioning {
    enabled = true
  }

  lifecycle_rule {
    condition {
      num_newer_versions = 20
    }
    action {
      type = "Delete"
    }
  }
}

resource "google_service_account" "terraform" {
  project      = module.seed.project_id
  account_id   = "terraform-fnol"
  display_name = "Terraform for FNOL platform stages 1 and 2"
}

# Organization-level roles the Terraform account needs. Kept to the minimum
# for creating folders, policies and the VPC-SC access policy; all other
# rights are granted on the fnol folder only.
locals {
  org_roles = [
    "roles/accesscontextmanager.policyAdmin",
    "roles/orgpolicy.policyAdmin",
    "roles/resourcemanager.organizationViewer",
  ]
  folder_roles = [
    "roles/resourcemanager.folderAdmin",
    "roles/resourcemanager.projectCreator",
    "roles/resourcemanager.projectIamAdmin",
    "roles/compute.xpnAdmin",
    "roles/compute.networkAdmin",
    "roles/compute.securityAdmin",
    "roles/logging.configWriter",
    "roles/serviceusage.serviceUsageAdmin",
    "roles/owner",
  ]
}

resource "google_organization_iam_member" "terraform" {
  for_each = toset(local.org_roles)
  org_id   = var.org_id
  role     = each.value
  member   = "serviceAccount:${google_service_account.terraform.email}"
}

resource "google_folder_iam_member" "terraform" {
  for_each = toset(local.folder_roles)
  folder   = google_folder.fnol.name
  role     = each.value
  member   = "serviceAccount:${google_service_account.terraform.email}"
}

resource "google_billing_account_iam_member" "terraform" {
  billing_account_id = var.billing_account
  role               = "roles/billing.user"
  member             = "serviceAccount:${google_service_account.terraform.email}"
}

resource "google_storage_bucket_iam_member" "terraform_state" {
  bucket = google_storage_bucket.tfstate.name
  role   = "roles/storage.objectAdmin"
  member = "serviceAccount:${google_service_account.terraform.email}"
}

# Platform admins run Terraform by impersonating the service account.
# No service account keys are ever created.
resource "google_service_account_iam_member" "admins_impersonate" {
  service_account_id = google_service_account.terraform.name
  role               = "roles/iam.serviceAccountTokenCreator"
  member             = "group:${var.platform_admins_group}"
}

resource "local_file" "backend_hint" {
  filename = "${path.module}/../backend.auto.hcl"
  content  = <<-EOT
    # Generated by 0-bootstrap. Pass with: terraform init -backend-config=../backend.auto.hcl
    bucket = "${google_storage_bucket.tfstate.name}"
  EOT
}
